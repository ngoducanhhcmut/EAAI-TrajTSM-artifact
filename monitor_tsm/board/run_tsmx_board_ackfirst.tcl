# Claude 04/11/2026: ZCU106 board replay of TSM-X (no firmware: xsdb drives the AXI-Lite registers over JTAG).
# Same per-job order as tb/board/tb_tsmx_stream.sv (the board-equivalent simulation):
#   [reset -> bring-up] -> TIME_US/ACK -> frame into AXI-Stream FIFO -> response -> consume ->
#   recorder read -> command frames -> CSR reason/status/lost/cycles.
# usage (PuTTY not needed):  C:\Vivado\Vivado\2023.2\bin\xsdb.bat run_tsmx_board.tcl <tag> [first_job] [n_jobs]
#   <tag> = board/vectors/<tag>.tcl generated by gen_board_vectors.py. Result: board/results/<tag>_<time>.log
set HERE [file normalize [file dirname [info script]]]
set ROOT [file normalize [file join $HERE .. .. ..]]
set BIT  [file join $HERE out system_wrapper_tsmx.bit]
# optional: set TSMX_OUT=out_187.5 to run the 187.5 MHz bitstream
if {[info exists ::env(TSMX_OUT)]} { set BIT [file join $HERE $::env(TSMX_OUT) system_wrapper_tsmx.bit] }
set PSU  [file join $ROOT deliverables zcu106 psu_init_zcu106_ram_x16_8gb.tcl]
set TAG  [lindex $argv 0]
set FIRST [expr {[llength $argv] > 1 ? [lindex $argv 1] : 0}]
source [file join $HERE vectors $TAG.tcl]
set COUNT [expr {[llength $argv] > 2 ? [lindex $argv 2] : $NJOBS - $FIRST}]
file mkdir [file join $HERE results]
set LOGF [file join $HERE results "${TAG}_ackfirst_[clock format [clock seconds] -format %Y%m%d_%H%M%S].log"]
set LOG [open $LOGF w]
proc say {msg} { global LOG; puts $msg; puts $LOG $msg; flush $LOG }
proc fail {msg} { say "BOARD_FAIL $msg"; exit 1 }

# ---- address map (board/build_tsmx_zcu106.tcl) ----
set SHIM 0xA0000000; set CSR 0xA0010000; set FIFO 0xA0020000
proc w {base off val} { mwr -force [format 0x%08X [expr {$base + $off}]] $val }
proc r {base off} { return [mrd -force -value [format 0x%08X [expr {$base + $off}]] 1] }
proc wait_bit {base off mask what {tries 20000}} {
  for {set i 0} {$i < $tries} {incr i} { if {[r $base $off] & $mask} { return $i } }
  fail "timeout waiting for $what"
}

# ---- program the board ----
foreach f [list $BIT $PSU] { if {![file exists $f]} { fail "missing $f" } }
say "BIT $BIT"
if {[catch {connect} e]} { fail "JTAG connect: $e" }
after 2000
targets -set -nocase -filter {name =~ "*PSU*"}
rst -system
after 1500
targets -set -nocase -filter {name =~ "*PSU*"}
source $PSU
if {[catch {psu_init} e]} { fail "psu_init: $e" }
after 1000
if {[catch {fpga -file $BIT} e]} { fail "fpga: $e" }
after 500
targets -set -nocase -filter {name =~ "*PSU*"}
mwr 0xFFCA0038 0x1FF
if {[catch {psu_ps_pl_isolation_removal} e]} { fail "isolation removal: $e" }
if {[catch {psu_ps_pl_reset_config} e]} { fail "PL reset release: $e" }
after 200
set id [r $SHIM 0x28]
if {$id != 0x75B0A1D4} { fail [format "shim ID 0x%08X (bitstream/AXI path wrong)" $id] }
say [format "SHIM_ID 0x%08X" $id]

# ---- FIFO reset ----
w $FIFO 0x28 0xA5; w $FIFO 0x08 0xA5; w $FIFO 0x18 0xA5; w $FIFO 0x00 0xFFFFFFFF
say [format "FIFO TDFV=%d RDFO=%d" [r $FIFO 0x0C] [r $FIFO 0x1C]]

proc bringup {} {
  global CSR
  w $CSR 0x00 0x4
  set n 0
  while {[r $CSR 0x4C] != 1} { incr n; if {$n > 20000} { fail "CONFIG_VALID never set" } }
  w $CSR 0x00 0x1
  if {[r $CSR 0x00] != 1} { fail "CTRL.en not set" }
  return $n
}
proc core_reset {} {
  global SHIM
  w $SHIM 0x00 0; after 1; w $SHIM 0x00 1; after 1
}

core_reset
set log_count 0
set t0 [clock milliseconds]
for {set j $FIRST} {$j < $FIRST + $COUNT} {incr j} {
  lassign $JOB($j) reset tm ack seq
  if {$reset} { core_reset; set log_count 0; set polls [bringup]; say "RESET job=$j bringup_polls=$polls" }
  # time / ACK exactly as the bench: ACK is a one-cycle pulse before the frame
  # Claude 08/11: ACK variant - seq and ACK pulse are applied before TIME_US is advanced (the bench applies both in one cycle)
  w $SHIM 0x08 $seq
  if {$ack} { w $SHIM 0x0C 1 }
  w $SHIM 0x04 $tm
  # request frame (store-and-forward: transmission starts at the TLR write)
  if {[r $FIFO 0x0C] < 1399} { fail "job=$j FIFO vacancy" }
  foreach x $RX($j) { w $FIFO 0x10 $x }
  w $FIFO 0x14 5593
  wait_bit $SHIM 0x10 0x1 "job=$j response"
  set lo [r $SHIM 0x14]; set hi [r $SHIM 0x18]; set st [r $SHIM 0x10]
  wait_bit $SHIM 0x10 0x10 "job=$j cycle counter"
  set cyc [r $SHIM 0x1C]
  w $SHIM 0x10 1
  # recorder read, oldest first (same index rule as the bench)
  incr log_count
  set idx [expr {$log_count > 64 ? 63 : $log_count - 1}]
  w $SHIM 0x20 $idx
  wait_bit $SHIM 0x10 0x20 "job=$j log"
  set ev {}
  for {set k 32} {$k >= 0} {incr k -1} { append ev [format %08x [r $SHIM [expr {0x100 + 4*$k}]]] }
  # command frames delivered into the FIFO receive side
  set frames {}
  after 1
  while {[r $FIFO 0x1C] > 0} {
    set bytes [r $FIFO 0x24]
    set words {}
    for {set k 0} {$k < ($bytes + 3) / 4} {incr k} { lappend words [format %08x [r $FIFO 0x20]] }
    lappend frames "$bytes:[join $words ,]"
  }
  set reason [r $CSR 0x28]; set status [r $CSR 0x04]; set lost [r $CSR 0x24]; set ccyc [r $CSR 0x2C]
  say [format "JOB %d rsp=%02x%08x stat=%02x cycles=%d csr_cycles=%d reason=%d status=%08x lost=%08x frames=%d event=%s cmd=%s" \
       $j $hi $lo $st $cyc $ccyc $reason $status $lost [llength $frames] $ev [join $frames ";"]]
}
say "BOARD_DONE jobs=$COUNT seconds=[expr {([clock milliseconds] - $t0) / 1000.0}] log=$LOGF"
close $LOG
exit 0
